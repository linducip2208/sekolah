APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://eschool.whitelabel.co.id

# Multi-tenant base domain (subdomain pattern: {school}.{base})
TENANT_BASE_DOMAIN=eschool.whitelabel.co.id
SUPER_ADMIN_DOMAIN=admin.eschool.whitelabel.co.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# eSchool SaaS — Production Configuration
# ============================================================

# License v3 (whitelabel.co.id pairing kit)
# Activation key is entered via /__pair browser wizard — NOT here.
LICENSE_SERVER_URL=https://whitelabel.co.id
LICENSE_DEV_BYPASS=true          # true di local, false di production
LICENSE_HEARTBEAT_INTERVAL=86400 # 24 jam
LICENSE_HEARTBEAT_GRACE=604800   # 7 hari grace kalau marketplace down

# Multi-tenancy grace
TENANT_GRACE_PERIOD_DAYS=7

# Firebase Cloud Messaging (push notifications)
FCM_SERVER_KEY=

# Soketi / Pusher (real-time chat) — use Reverb
BROADCAST_CONNECTION=reverb

PUSHER_APP_ID=eschool
PUSHER_APP_KEY=eschool-key
PUSHER_APP_SECRET=eschool-secret
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=http

REVERB_APP_ID=eschool
REVERB_APP_KEY=eschool-key
REVERB_APP_SECRET=eschool-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=eschool.whitelabel.co.id
REVERB_PORT=443
REVERB_SCHEME=https

# Sentry (optional error tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup
BACKUP_DISK=local
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSWORD=

# ============================================================
# IMPORTANT: NO HARDCODED 3RD-PARTY PROVIDER KEYS HERE
# ============================================================
# Per global rule "No Hardcoded Providers":
# - Payment gateway keys (Midtrans, Xendit, Doku) — input via admin UI per school
# - AI provider keys (OpenAI, Anthropic, Gemini) — input via admin UI per school
# - Video conference (Zoom, Meet) — input via admin UI per school
# - SMS gateway — input via admin UI per school
#
# These are NOT in .env. They live in DB tables (payment_providers, ai_providers,
# video_providers) encrypted via Laravel Crypt::encryptString().
# ============================================================
